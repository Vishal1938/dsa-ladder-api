# Copy to .env for docker compose. Never commit .env.
JWT_SECRET=paste-a-random-string-of-at-least-32-characters
# Where the frontend is served from (comma-separated)
CORS_ORIGINS=http://localhost:5173
# docker compose already points the API at its own mongo service. Set this only to use
# an external database, e.g. MongoDB Atlas (the path must name the database):
# MONGODB_URI=mongodb+srv://user:password@cluster0.example.mongodb.net/dsaladder?retryWrites=true&w=majority
